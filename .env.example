# Deployment settings. Everything operational -- Africa's Talking credentials,
# the voice number, the phone to test against -- is entered on the Setup screen
# instead, so the platform can be configured without shell access.

# Leave unset to use a local SQLite file (./mabia.db). No Docker required.
# DATABASE_URL=postgresql://user:pass@host:5432/mabia

JWT_SECRET=change-me-in-production
JWT_TTL_HOURS=12

# The public HTTPS address Africa's Talking calls back on. For local testing:
#   ngrok http 8000
# then paste the https URL here, or into the Setup screen.
PUBLIC_BASE_URL=

CORS_ORIGINS=*
SEED_ON_START=1
