# ---------------------------------------------------------------------------
# Mabia AI — local secrets. This file is gitignored and never leaves your
# machine. Fill in what you have; blanks are fine and the app still runs.
# ---------------------------------------------------------------------------

# --- Khaya / GhanaNLP -------------------------------------------------------
# Powers translation into Dagbani, Kusaal, Frafra and Gonja, and text-to-speech.
# Get a key from the GhanaNLP developer portal.
GHANANLP_API_KEY=

# --- Africa's Talking -------------------------------------------------------
# "sandbox" in the sandbox environment, or your app username when live.
AT_USERNAME=sandbox
AT_API_KEY=
# The number that places calls, e.g. +233XXXXXXXXX
AT_VOICE_NUMBER=
# sandbox | live
AT_ENVIRONMENT=sandbox
# Alphanumeric sender IDs need registration in Ghana.
AT_SENDER_ID=MABIA

# --- Your handset -----------------------------------------------------------
# The phone that receives test calls and messages, e.g. +233XXXXXXXXX
TEST_PHONE=

# --- Local development ------------------------------------------------------
# Africa's Talking must reach this server over HTTPS during a call.
#   ngrok http 8000
# then paste the https URL here.
PUBLIC_BASE_URL=

JWT_SECRET=dev-secret-change-me
SEED_ON_START=1
